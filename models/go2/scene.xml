<mujoco model="go2">
  <include file="robot.xml" />
  <compiler angle="radian" autolimits="true" meshdir="./meshes" />
  <!-- Control and integration period for BOTH pipelines: the native supervisor
       and RLPipelineRuntime each call simHWGetStepPeriod() and adopt this. -->
  <option timestep="0.001" />
  <statistic meansize="0.233652" extent="1.00882" center="0 0 -0.175588" />
  <asset>
    <!-- <hfield name="hmap" file="my_output_image.png" size="3 3 0.3 0.07"/> -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="32"
      height="192" />
    <texture type="cube" name="body" builtin="flat" mark="cross" rgb1="0.8 0.6 0.4"
      rgb2="0.8 0.6 0.4" markrgb="1 1 1" width="127" height="762" />
    <texture type="2d" name="grid" builtin="checker" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4"
      width="512" height="512" />
    <material name="body" texture="body" texuniform="true" rgba="0.8 0.6 0.4 1" />
    <material name="grid" texture="grid" texuniform="true" reflectance="0.2" />
    <!-- <mesh name="slope" file="slope.stl" scale="1 1 1" /> -->
  </asset>
  <worldbody>
    <geom name="floor" size="0 0 1" type="plane" material="grid" friction="1.0 0.005 0.0001" />

    <light name="spotlight" target="go2/base_link_inertia" pos="0 -6 6" dir="0 0 -1" cutoff="30"
      diffuse="0.8 0.8 0.8" mode="targetbodycom" />


    <!-- <body name="slope40" pos="-3 1 0">
      <geom name="slope40_geom" type="box" size="2 4 0.1" pos="0 0 0"
        quat="0.9397 0.3420 0 0" rgba="0.8 0.3 0.3 1" />
    </body>
 -->

    <!-- <body pos="1. 1 0" euler="0 0 1.57">
      <inertial pos="0.5 .5 0" mass="18" />
      <geom type="mesh" mesh="slope" name="slope" rgba=".9 0 0 0.1" />
    </body> -->

  </worldbody>
  <actuator>
    <motor name="go2/abad_1_torque" joint="go2/abad_1_joint" forcelimited="true"
      forcerange="-23.7 23.7" />
    <motor name="go2/hip_1_joint" joint="go2/hip_1_joint" forcelimited="true"
      forcerange="-23.7 23.7" />


    <motor name="go2/knee_1_joint" joint="go2/knee_1_joint" forcelimited="true"
      forcerange="-45.43 45.43" />


    <motor name="go2/abad_2_torque" joint="go2/abad_2_joint" forcelimited="true"
      forcerange="-23.7 23.7" />
    <motor name="go2/hip_2_joint" joint="go2/hip_2_joint" forcelimited="true"
      forcerange="-23.7 23.7" />


    <motor name="go2/knee_2_joint" joint="go2/knee_2_joint" forcelimited="true"
      forcerange="-45.43 45.43" />


    <motor name="go2/abad_3_torque" joint="go2/abad_3_joint" forcelimited="true"
      forcerange="-23.7 23.7" />

    <motor name="go2/hip_3_joint" joint="go2/hip_3_joint" forcelimited="true"
      forcerange="-23.7 23.7" />


    <motor name="go2/knee_3_joint" joint="go2/knee_3_joint" forcelimited="true"
      forcerange="-45.43 45.43" />


    <motor name="go2/abad_4_torque" joint="go2/abad_4_joint" forcelimited="true"
      forcerange="-23.7 23.7" />

    <motor name="go2/hip_4_joint" joint="go2/hip_4_joint" forcelimited="true"
      forcerange="-23.7 23.7" />


    <motor name="go2/knee_4_joint" joint="go2/knee_4_joint" forcelimited="true"
      forcerange="-45.43 45.43" />


  </actuator>

  <contact>

    <exclude body1="go2/hip_1" body2="go2/base_link_inertia" />
    <exclude body1="go2/hip_2" body2="go2/base_link_inertia" />
    <exclude body1="go2/hip_3" body2="go2/base_link_inertia" />
    <exclude body1="go2/hip_4" body2="go2/base_link_inertia" />

    <exclude body1="go2/knee_1" body2="go2/base_link_inertia" />
    <exclude body1="go2/knee_2" body2="go2/base_link_inertia" />
    <exclude body1="go2/knee_3" body2="go2/base_link_inertia" />
    <exclude body1="go2/knee_4" body2="go2/base_link_inertia" />



  </contact>
  <sensor>
    <accelerometer name="acc" site="sensorsurf" />
    <gyro site="sensorsurf" />
    <framequat name="quat" objtype="body" objname="go2/base_link_inertia" />
  </sensor>


</mujoco>
