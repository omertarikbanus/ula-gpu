+      << ",\"dt_s\":" << std::setprecision(6) << runtime.stepPeriodSeconds()
+      << ",\"scene_path\":\"" << jsonEscape(kDefaultScenePath) << "\""
+      << ",\"scene_sha256\":\"" << scene_sha << "\""
+      << ",\"urdf_path\":\"" << jsonEscape(kDefaultUrdfPath) << "\""
+      << ",\"urdf_sha256\":\"" << urdf_sha << "\""
+      << ",\"config_path\":\"" << jsonEscape(config_path) << "\""
+      << ",\"config_sha256\":\"" << config_sha << "\""
