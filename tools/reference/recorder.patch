+
+  std::ostringstream effective_cfg_ss;
+  effective_cfg_ss << "# effective_config_snapshot\n"
+                   << "# config_path=" << config_path << "\n"
+                   << "# --- control_params.toml ---\n"
+                   << ctrl_toml << "\n"
+                   << "# --- simulation.toml ---\n"
+                   << sim_toml << "\n"
+                   << "# --- envpool.toml ---\n"
+                   << envpool_toml << "\n"
+                   << "# --- sim_config_overlay ---\n"
+                   << kSimConfigOverlay << "\n"
+                   << "# --- runtime_effective_parameters ---\n"
+                   << effective_params_ss.str();
+  const std::string config_sha = sha256String(effective_cfg_ss.str());
+
+  std::ofstream out(output_path, std::ios::trunc);
+  if (!out) {
+    std::cerr << "Failed to open output trace: " << output_path << "\n";
+    return 1;
+  }
+
+  // Emit manifest.
+  out << std::fixed;
+  out << "{"
+      << "\"type\":\"manifest\""
+      << ",\"schema\":\"ula-controller-replay\""
+      << ",\"version\":1"
+      << ",\"reference_commit\":\"" << kReferenceCommit << "\""
