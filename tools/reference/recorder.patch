+      out << ",\"sim_substep0_actuator_force\":";
+      writeJsonArray(out, cap.sim_substep0_actuator_force, 9);
+      out << ",\"sim_substep1_actuator_force\":";
+      writeJsonArray(out, cap.sim_substep1_actuator_force, 9);
+      out << ",\"wbic_Fr\":";
+      writeJsonArray(out, cap.wbic_Fr, 9);
