+          allFinite(cap.position_w) && allFinite(cap.orientation_wxyz) &&
+          allFinite(cap.linear_velocity_b) && allFinite(cap.angular_velocity_b) &&
+          allFinite(cap.wbic_joint_position) &&
+          allFinite(cap.wbic_joint_velocity) &&
+          allFinite(cap.measured_contact) &&
+          allFinite(cap.leg_controller_joint_position) &&
+          allFinite(cap.leg_controller_joint_velocity) &&
+          std::isfinite(cap.gait_phase) &&
+          allFinite(cap.foot_position_target) &&
+          allFinite(cap.joint_position_target) &&
+          allFinite(cap.joint_velocity_target) &&
+          allFinite(cap.feedforward_torque) &&
+          allFinite(cap.motor_torque) &&
+          allFinite(cap.sim_substep0_actuator_force) &&
+          allFinite(cap.sim_substep1_actuator_force);
+      if (!finite_ok) {
+        std::cerr << "Non-finite value detected at episode=" << ep
